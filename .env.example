# ─── SynapseOS Environment Configuration ─────────────────────────────────────
# Rename this file to .env before starting SynapseOS

# 1. Obsidian Vault Storage
# Path to your Obsidian vault on your host machine to mount inside containers
LOCAL_VAULT_PATH=./vault

# 2. Local Ollama LLM Connection (Default: localhost:11434)
# When running in Docker, host.docker.internal connects to host Ollama instance
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LLM_MODEL=gemma4:31b-cloud

# 3. Database Backend Configuration (postgres or sqlite)
DATABASE_BACKEND=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_saas
POSTGRES_PORT=5432

# 4. Web & API URLs
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# 5. Optional BYOK (Bring Your Own Key) Cloud Providers
# Leave blank if using local Ollama exclusively
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# OPENROUTER_API_KEY=sk-or-v1-...
