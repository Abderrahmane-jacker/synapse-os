# ─── SynapseOS Environment Configuration ─────────────────────────────────────
# Copy this file to .env before starting SynapseOS

# 1. Obsidian / Markdown Knowledge Vault
# Path to your Obsidian or Markdown notes folder on host filesystem
LOCAL_VAULT_PATH=./vault
OBSIDIAN_VAULT_PATH=./vault

# 2. Operator & AI Agent Identity
OPERATOR_NAME=Operator
AGENT_NAME=Synapse

# 3. AI Providers & Dynamic Routing
# Primary Provider: omniroute (default), ollama, anthropic, gemini, openai, openrouter
LLM_PROVIDER=omniroute
DEFAULT_LLM_MODEL=auto/best-coding

# OmniRoute Gateway (Unified Multi-Provider Dynamic Routing)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=

# Local Ollama LLM Connection (Default: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud BYOK (Bring Your Own Key) Direct Providers
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# OPENROUTER_API_KEY=sk-or-v1-...

# 4. Database & Storage Configuration
# Choose 'sqlite' (zero-config local) or 'postgres' (pgvector)
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=./nexus.db

# PostgreSQL pgvector (Optional for enterprise multi-user mode)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_saas
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/nexus_saas

# 5. Network Ports
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
